# Supabase — z panelu projektu: Settings → API
# WYMAGANE: URL projektu
NEXT_PUBLIC_SUPABASE_URL=
# WYMAGANE: service_role (TAJNE!) — aplikacja czyta/zapisuje dane po stronie serwera
SUPABASE_SERVICE_ROLE_KEY=
# OPCJONALNE: klucz publiczny (nowa nazwa: "publishable", dawniej "anon").
# Ta aplikacja go NIE używa (cała komunikacja z bazą idzie przez service_role
# w route handlerach). Zostawione na przyszłość.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ochrona aplikacji hasłem (MVP). Jedno hasło dla całej aplikacji.
APP_PASSWORD=
