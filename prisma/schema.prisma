generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== TENANTS ====================
model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  users     User[]
  farms     Farm[]
  varieties  Variety[]
  templates  ProductionCurveTemplate[]
  
  @@map("tenants")
}

// ==================== USERS ====================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("MANAGER")
  
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@map("users")
}

// ==================== FARMS ====================
model Farm {
  id              String    @id @default(cuid())
  name            String
  location        String?
  latitude        Float?
  longitude       Float?
  seasonStartDate DateTime?
  
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  
  blocks          Block[]
  workers         Worker[]
  weatherData     WeatherData[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("farms")
}

// ==================== BLOCKS ====================
model Block {
  id       String    @id @default(cuid())
  name     String
  areaHa   Float?
  
  farmId   String
  farm     Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  
  sections Section[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("blocks")
}

// ==================== VARIETIES ====================
model Variety {
  id                    String    @id @default(cuid())
  name                  String
  origin                String?
  description           String?
  
  yieldSummerPerShoot   Float?
  yieldAutumnPerShoot   Float?
  
  gdhSummer             Int?
  gdhAutumn             Int?
  baseTemp              Float?    @default(6.0)
  
  gdhWinteredFlower     Int?      // GDH do kwitnienia (zimowane w tunelu)
  gdhWinteredFruit      Int?      // GDH do pierwszego zbioru (zimowane)
  gdhLcFlower           Int?      // GDH do kwitnienia (LC ze szkółki)
  gdhLcFruit            Int?      // GDH do pierwszego zbioru (LC)
  gdhAutumnFlower       Int?      // GDH od pędów do kwitnienia (jesień)
  gdhAutumnFruit        Int?      // GDH od pędów do owoców (jesień)
  
  harvestCurveSummer    Json?
  harvestCurveAutumn    Json?
  autumnStartWeek       Int?      // Tydzień startu jesieni (np. 33 = połowa sierpnia)

  pickingEfficiency     Float?
  wastePercent          Float?
  secondCategoryPercent Float?
  
  isCustom              Boolean   @default(false)
  
  tenantId              String?
  tenant                Tenant?   @relation(fields: [tenantId], references: [id])
  
  sections              Section[]
  harvestCurves         HarvestCurve[]
  templates             ProductionCurveTemplate[] @relation("TemplateVariety")  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("varieties")
}

// ==================== ENUMS ====================
enum PlantSource {
  OWN
  NURSERY
}

// ==================== SECTIONS ====================
model Section {
  id                    String    @id @default(cuid())
  name                  String?
  
  metersLength          Float
  potsPerMeter          Float
  shootsPerPot          Float
  potsOverride          Int?
  
  plantingYear          Int?
  productionYear        Int?
  
  plantMaterialType     String?
  plantSource           PlantSource?

  yieldSummerPerShoot   Float?
  yieldAutumnPerShoot   Float?
  
  gdhSummer             Int?
  gdhAutumn             Int?
  baseTemp              Float?    @default(6.0)
  
  gdhWinteredFlower     Int?      // GDH do kwitnienia (zimowane w tunelu)
  gdhWinteredFruit      Int?      // GDH do pierwszego zbioru (zimowane)
  gdhLcFlower           Int?      // GDH do kwitnienia (LC ze szkółki)
  gdhLcFruit            Int?      // GDH do pierwszego zbioru (LC)
  gdhAutumnFlower       Int?      // GDH od pędów do kwitnienia (jesień)
  gdhAutumnFruit        Int?      // GDH od pędów do owoców (jesień)
  
  certificateUrl        String?
  deliveryProofUrl      String?
  
  blockId               String
  block                 Block     @relation(fields: [blockId], references: [id], onDelete: Cascade)
  
  varietyId             String
  variety               Variety   @relation(fields: [varietyId], references: [id])
  
  harvests              Harvest[]
  weeklyOverrides       WeeklyOverride[]
  harvestCurves         HarvestCurve[]
  
  temperatureReadings   TemperatureReading[]
  winteredInTunnel      Boolean   @default(false)
  templateAssignments   SectionTemplateAssignment[]
  sourceTemplates       ProductionCurveTemplate[] @relation("TemplateSource")
  harvestSeasons        HarvestSeason[]
  plantingDate          DateTime?
  winterShootsDate      DateTime?
  harvestCurveSummer    Float[]   @default([])
  harvestCurveAutumn    Float[]   @default([])

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("sections")
}

// ==================== HARVEST CURVES ====================
model HarvestCurve {
  id            String   @id @default(cuid())
  year          Int                          // rok danych (2023, 2024, 2025)
  season        String?                      // 'summer' | 'autumn' | null (combined)
  curve         Float[]                      // % na tydzień [5, 12, 18, 22, 20, 13, 7, 3]
  dailyCurve    Float[]                      // kg na dzień
  startDate     String?                      // data startu zbioru
  totalKg       Float                        // suma kg w sezonie
  startWeek     Int                          // tydzień startu zbioru
  
  sectionId     String?
  section       Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  
  varietyId     String?
  variety       Variety? @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  
  sourceFile    String?                      // nazwa pliku MaxCrop
  name          String?                      // opcjonalna nazwa (wymagana dla merged)
  isArchived    Boolean  @default(false)
  mergedFromIds String[]                     // ID krzywych źródłowych

  commercialStartDate       DateTime?
  commercialStartDateAutumn DateTime?

  winteredInTunnel  Boolean?
  plantingDate      DateTime?
  plantSource       PlantSource?
  plantingYear      Int?
  autumnShootDate   DateTime?

  importedAt    DateTime @default(now())
  
  templateAssignments SectionTemplateAssignment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("harvest_curves")
}

// ==================== WEEKLY OVERRIDES ====================
model WeeklyOverride {
  id                String   @id @default(cuid())
  
  weekNumber        Int
  year              Int
  pickingEfficiency Float?
  notes             String?
  
  sectionId         String
  section           Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([sectionId, weekNumber, year])
  @@map("weekly_overrides")
}

// ==================== WEATHER ====================
model WeatherData {
  id            String   @id @default(cuid())
  date          DateTime @db.Date
  tempMin       Float
  tempMax       Float
  tempAvg       Float?
  gdhDaily      Float
  gdhCumulative Float
  source        String?
  
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  
  @@unique([farmId, date])
  @@map("weather_data")
}

// ==================== HISTORICAL GDH ====================
model HistoricalGdh {
  id            String   @id @default(cuid())
  dayOfYear     Int
  avgGdh        Float
  minGdh        Float?
  maxGdh        Float?
  yearsCount    Int?
  
  farmId        String
  
  @@unique([farmId, dayOfYear])
  @@map("historical_gdh")
}

// ==================== WORKERS ====================
model Worker {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  passport          String?
  passportFileUrl   String?

  availableFrom     DateTime? @db.Date
  availableTo       DateTime? @db.Date
  suggestedArrival  DateTime? @db.Date
  confirmedArrival  DateTime? @db.Date

  referredBy        String?
  yearsAtPlantation Int       @default(0)

  status            String    @default("new")

  acceptedToList    Boolean   @default(false)
  acceptedToListMsg String?
  arrivalConfirmed  Boolean   @default(false)
  arrivalConfirmMsg String?

  whatsapp          String?
  viber             String?
  phone             String?

  efficiencyKgH     Float     @default(8.0)
  isActive          Boolean   @default(true)

  farmId            String
  farm              Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("workers")
}

// ==================== HARVESTS ====================
model Harvest {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  yieldKg      Float
  notes        String?
  season       String?  // 'summer' | 'autumn'
  isPreHarvest Boolean  @default(false) // "pośpiech" — nie liczymy jako start komercyjny

  sectionId    String
  section      Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@map("harvests")
}

// ==================== HARVEST SEASONS (tracking commercial start per section/season/year) ====================
model HarvestSeason {
  id                     String    @id @default(cuid())
  year                   Int
  season                 String    // 'summer' | 'autumn'
  commercialStartDate    DateTime? @db.Date // data zakotwiczenia — ręcznie potwierdzona
  gdhPredictedStartDate  DateTime? @db.Date // prognoza startu z GDH

  sectionId              String
  section                Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([sectionId, year, season])
  @@map("harvest_seasons")
}

// ==================== PRODUCTION CURVE TEMPLATES ====================
model ProductionCurveTemplate {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  
  tenantId            String?
  tenant              Tenant?  @relation(fields: [tenantId], references: [id])
  
  varietyId            String?
  variety              Variety? @relation("TemplateVariety", fields: [varietyId], references: [id], onDelete: SetNull)
  
  productionYear      Int                          // year of data (2024, 2025)
  productionCycle     Int      @default(1)          // 1st/2nd/3rd year of production
  plantingDate        String?                       // when planted
  winteredInTunnel    Boolean  @default(false)
  plantSource         String?                       // 'long_canes' | 'tray_plants' | 'nursery'
  
  // Production curve data - Summer
  dailyCurveSummer    Float[]
  weeklyCurveSummer   Float[]
  startDateSummer     String?
  endDateSummer       String?
  startWeekSummer     Int?
  totalKgSummer       Float    @default(0)
  
  // Production curve data - Autumn
  dailyCurveAutumn    Float[]
  weeklyCurveAutumn   Float[]
  startDateAutumn     String?
  endDateAutumn       String?
  startWeekAutumn     Int?
  totalKgAutumn       Float    @default(0)
  
  // Historical temperature data
  outsideTemps        Json?                         // [{date, min, max, avg}]
  insideTunnelTemps   Json?                         // [{date, min, max, avg}]
  tempAdjustmentFactor Float?                       // inside/outside ratio
  
  // GDH data
  gdhData             Json?                         // [{date, gdh, cumulativeGdh}]
  gdhToFlowering      Float?                        // cumulative GDH at flowering
  gdhToFirstFruit     Float?                        // cumulative GDH at first fruit
  
  // Temperature data sources
  tempSources         String[]                      // ['MANUAL','API','SENSORS']
  
  sourceSectionId     String?
  sourceSection       Section?  @relation("TemplateSource", fields: [sourceSectionId], references: [id], onDelete: SetNull)

  summerEndWeek       Int?
  sourceFile          String?
  notes               String?
  sourceHarvestCurveIds String[]                    // IDs of HarvestCurve records used to create this template
  sourceAreaNames     String[]                      // Names of source areas used to create this template

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Sections using this template
  sectionAssignments  SectionTemplateAssignment[]

  @@map("production_curve_templates")
}

model SectionTemplateAssignment {
  id                  String   @id @default(cuid())

  sectionId           String
  section             Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  templateId          String
  template            ProductionCurveTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  targetYear          Int                          // which year this assignment is for (2026)
  season              String   @default("summer")  // 'summer' | 'autumn'
  adjustmentPercent   Float    @default(0)          // +/- % adjustment to curve
  adjustedCurve       Float[]                       // final adjusted daily curve

  harvestCurveId      String?
  harvestCurve        HarvestCurve? @relation(fields: [harvestCurveId], references: [id], onDelete: SetNull)

  isActive            Boolean  @default(true)

  plantingDate        String?                       // actual planting date for this assignment

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([sectionId, templateId, targetYear, season])
  @@map("section_template_assignments")
}


// ==================== TEMPERATURE READINGS (from PDF loggers) ====================
model TemperatureReading {
  id            String   @id @default(cuid())

  timestamp     DateTime                      // date+time of the reading
  temperature   Float                         // temperature in °C

  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  sourceFile    String?                       // PDF filename for traceability
  importedAt    DateTime @default(now())

  @@unique([sectionId, timestamp])
  @@index([sectionId, timestamp])
  @@map("temperature_readings")
}

// ==================== FEEDBACK ====================
model Feedback {
  id        String   @id @default(cuid())
  message   String
  category  String   @default("general")
  page      String?
  userName  String?
  userEmail String?
  tenantName String?
  createdAt DateTime @default(now())
}
